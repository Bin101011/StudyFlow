# 가상환경 (라이브러리가 쌓이는 큰 폴더라 올리지 않음)
.venv/

# Python이 자동으로 만드는 캐시
__pycache__/
*.pyc

# Google 인증 파일 (비밀번호와 같음, 절대 올리면 안 됨)
credentials.json
token.json

# 개인 데이터
studyflow.db
# DB를 하루에 한 번 복사해 둔 백업 (내 할 일과 메모가 들어 있다)
db_backup/
settings.json
settings.json.tmp

# 기억해둔 일정(내 일정 내용이 들어 있다)과, 바로가기로 실행할 때 쌓이는 기록
events_cache.json
events_cache.json.tmp
studyflow.log
# 프로그램이 켜져 있는 동안 잡고 있는 잠금 파일 (StudyFlow를 두 번 켜지 못하게 한다)
studyflow.lock
# 노트 탭이 수정 전에 한 번씩 복사해 두는 노트 백업 (내 노트 내용이 들어 있다)
notes_backup/
